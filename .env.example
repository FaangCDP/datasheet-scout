# Datasheet Scout Environment Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Discord user ID yang diizinkan menggunakan perintah owner (default: 0 = tidak ada owner)
OWNER_ID=0

# Batas ukuran file download dalam MB (default: 25)
MAX_FILE_SIZE_MB=25

# Download folder untuk file PDF hasil unduhan (default: ./downloads)
DOWNLOAD_DIR=./downloads

# Cache ukuran maksimum dalam MB (default: 500)
MAX_CACHE_MB=500

# Cache umur maksimum dalam jam (default: 72)
MAX_CACHE_AGE_HOURS=72

# Total batas batch unduhan dalam MB (default: 5000)
MAX_TOTAL_MB=5000

# Batas ukuran PDF yang bisa diparse dalam MB (default: 40)
MAX_PDF_SIZE_MB=40

# Optional: Residential Proxy untuk AllDatasheet jika dijalankan di VPS/Hosting datacenter
# ALLDATASHEET_PROXY=http://username:password@proxy_host:port